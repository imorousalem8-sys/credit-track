# ==============================================================================
# CREDITTRACK PRO - EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT (SANS SECRETS RÉELS)
# ==============================================================================

# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Supabase (Serveur Backend Uniquement - Ne jamais exposer au frontend)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Base de données PostgreSQL directe (Optionnel si accès REST Supabase)
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@db.votre-projet.supabase.co:5432/postgres

# Sécurité & Chiffrement Sessions
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_64_caracteres_min
AUTH_SECRET=votre_cle_secrete_authentification

# Passerelles de Paiement (Serveur uniquement)
FEDAPAY_SECRET_KEY=votre_cle_secrete_fedapay
CINETPAY_API_KEY=votre_cle_secrete_cinetpay
CINETPAY_SITE_ID=votre_site_id_cinetpay

# Webhooks Secrets (Pour vérification cryptographique HMAC)
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_stripe
FEDAPAY_WEBHOOK_SECRET=votre_secret_webhook_fedapay

# Sécurité Réseau & CORS
CORS_ALLOWED_ORIGINS=https://credittrack.pro,https://www.credittrack.pro
NODE_ENV=production
