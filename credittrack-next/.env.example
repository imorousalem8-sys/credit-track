# Supabase Client Public
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Supabase Serveur Privé (Ne pas préfixer par NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Sécurité & Chiffrement
AUTH_SECRET=cle_secrete_chiffrement_session_64_bits
JWT_SECRET=secret_de_signature_jwt

# Webhooks & Paiements
PAYMENT_WEBHOOK_SECRET=votre_secret_webhook_signature
CORS_ALLOWED_ORIGINS=https://credit-track00.vercel.app,https://credittrack.pro,http://localhost:3000


# Environnement
NODE_ENV=development
